{
  "name": "nayler-remotion",
  "version": "1.0.0",
  "private": true,
  "description": "Animation du flyer ÑAYLER (IYAT TV) avec Remotion",
  "scripts": {
    "audio": "python3 scripts/generate_audio.py",
    "dev": "remotion studio",
    "render": "remotion render Nayler renders/nayler-960x1600.mp4 --codec=h264 --crf=16",
    "render:native": "remotion render NaylerNative renders/nayler-960x1280.mp4 --codec=h264 --crf=16",
    "still": "remotion still Nayler out/frame.png --frame=420",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.540",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.540"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
