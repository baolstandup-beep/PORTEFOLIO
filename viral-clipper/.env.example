# Copiez ce fichier en .env puis remplissez.

# Optionnel : active la sélection sémantique + titres rédigés par Claude.
# Sans clé, le pipeline utilise l'analyse heuristique locale.
ANTHROPIC_API_KEY=

# Toute option de src/config.py peut être surchargée avec le préfixe CLIPPER_ :
# CLIPPER_SOURCE=https://www.youtube.com/watch?v=ze95vrn-Xs8
# CLIPPER_WHISPER_MODEL=small        # tiny|base|small|medium|large-v3 (plus gros = plus précis, plus lent)
# CLIPPER_WHISPER_LANGUAGE=fr
# CLIPPER_MAX_CLIPS=6
# CLIPPER_CLIP_MAX_SECONDS=180
# CLIPPER_WHATSAPP_MAX_SECONDS=60
# CLIPPER_ENABLE_ZOOM=true
# CLIPPER_ENABLE_SFX=true
# CLIPPER_SUBTITLE_STYLE=podcast
# CLIPPER_EXPORT_PROFILES=TikTok,Reels,Shorts,WhatsApp_Statut
