# Connexion PostgreSQL (Neon, Supabase, Railway, serveur propre…). Ajouter ?sslmode=require en production.
DATABASE_URL=postgres://graphia:graphia@localhost:5432/graphia

# Secret de signature des sessions admin : 32 caractères aléatoires minimum.
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Nombre de places
MAX_PARTICIPANTS=50

# Adresse publique du site (liens dans les messages)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Notifications par e-mail (Resend : https://resend.com) ── facultatif
RESEND_API_KEY=
# Expéditeur sur un domaine vérifié dans Resend, ex. « GRAPHIA 2026 <candidatures@baolup.com> »
EMAIL_FROM=

# ── Notifications WhatsApp (WhatsApp Business Cloud API de Meta) ── facultatif
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Modèles approuvés dans le WhatsApp Manager (obligatoires pour écrire en premier à un candidat).
# Chaque modèle reçoit 2 variables : {{1}} = prénom, {{2}} = numéro de candidature.
WHATSAPP_TEMPLATE_LANG=fr
WHATSAPP_TEMPLATE_CONFIRMATION=
WHATSAPP_TEMPLATE_PRESELECTION=
WHATSAPP_TEMPLATE_SELECTION=
WHATSAPP_TEMPLATE_NON_SELECTION=

# ── Coordonnées affichées sur le site (facultatif : masquées si vides) ──
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# Date de clôture des candidatures (ISO 8601). Vide = formulaire ouvert.
# Exemple : 2026-11-20T23:59:00Z
APPLICATIONS_CLOSE_AT=
